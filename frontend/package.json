    "@types/jsonwebtoken": "^9.0.10",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/ui": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.0.1",
    "jsdom": "^22.0.0",
