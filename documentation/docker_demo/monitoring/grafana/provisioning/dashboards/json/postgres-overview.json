{
  "id": null,
  "title": "PostgreSQL Overview",
  "tags": ["postgres", "database"],
  "timezone": "browser",
  "schemaVersion": 30,
  "version": 1,
  "panels": [
    {
      "type": "graph",
      "title": "Connections",
      "targets": [
        {
          "expr": "pg_stat_activity_count",
          "legendFormat": "active connections"
        }
      ],
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 6 }
    },
    {
      "type": "graph",
      "title": "Transactions / sec",
      "targets": [
        {
          "expr": "rate(pg_stat_xact_commit[1m])",
          "legendFormat": "commits"
        },
        {
          "expr": "rate(pg_stat_xact_rollback[1m])",
          "legendFormat": "rollbacks"
        }
      ],
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 6 }
    },
    {
      "type": "graph",
      "title": "Rows Operations",
      "targets": [
        {
          "expr": "rate(pg_stat_tuples_returned[1m])",
          "legendFormat": "returned"
        },
        {
          "expr": "rate(pg_stat_tuples_fetched[1m])",
          "legendFormat": "fetched"
        },
        {
          "expr": "rate(pg_stat_tuples_inserted[1m])",
          "legendFormat": "inserted"
        },
        {
          "expr": "rate(pg_stat_tuples_updated[1m])",
          "legendFormat": "updated"
        },
        {
          "expr": "rate(pg_stat_tuples_deleted[1m])",
          "legendFormat": "deleted"
        }
      ],
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 6 }
    }
  ]
}
