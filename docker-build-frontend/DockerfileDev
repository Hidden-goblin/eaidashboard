# Dockerfile pour builder uniquement le front
FROM node:24

WORKDIR /frontend
COPY ./documentation/openapi.json ./
COPY ../frontend/package.json ./
RUN npm install --include=dev

ARG BUILD_TYPE=development
ENV RUN_TYPE=$BUILD_TYPE
ENV VITE_RUN_TYPE=$BUILD_TYPE

COPY ../frontend/ ./
RUN echo "Building frontend with mode=$BUILD_TYPE" && echo "VITE_RUN_TYPE=$VITE_RUN_TYPE" >> .env\
 && npm run build -- --mode $BUILD_TYPE
